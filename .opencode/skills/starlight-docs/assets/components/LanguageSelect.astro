---
/*
 * Generated by starlight-docs only when `--locales` has more than one entry.
 * A link list, not a <select>: the current language is shown by the trigger
 * text, and every entry points at the same slug in the other locale.
 */
import config from 'virtual:starlight/user-config'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const locales = config.locales ?? {}
const routeLocale = Astro.locals.starlightRoute.locale
const current = routeLocale && routeLocale in locales ? routeLocale : 'root'
const currentLabel = locales[current]?.label ?? current

const menuLabel = (() => {
  try {
    const value = Astro.locals.t('languageSelect.accessibleLabel')
    return value || 'Language'
  } catch {
    return 'Language'
  }
})()

function localizedPathname(code: string): string {
  let pathname = Astro.url.pathname
  if (base && pathname.startsWith(base)) pathname = pathname.slice(base.length)
  const segments = pathname.split('/').filter(Boolean)
  if (segments[0] && segments[0] in locales) segments.shift()
  const rest = segments.join('/')
  const prefix = code === 'root' ? '' : `${code}/`
  return `${base}/${prefix}${rest}${rest ? '/' : ''}`
}
---

{
  config.isMultilingual && (
    <div class="sd-menu" data-sd-menu data-sd-lang-menu>
      <button
        type="button"
        class="sd-menu-trigger"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <svg class="sd-menu-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path
            d="M3 12h18M12 3c2.5 2.6 3.8 5.8 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.8-3.8-9S9.5 5.6 12 3Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
          />
        </svg>
        <span>{currentLabel}</span>
        <svg class="sd-menu-caret" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" />
        </svg>
      </button>
      <ul class="sd-menu-list" aria-label={menuLabel}>
        {Object.entries(locales).map(([code, locale]) => (
          <li>
            <a
              href={localizedPathname(code)}
              aria-current={code === current ? 'page' : undefined}
              hreflang={locale?.lang}
            >
              {locale?.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
