{
  "name": "opencode-skill-management",
  "version": "1.1.0",
  "description": "OpenCode V2 plugin: list / inspect / disable / enable installed skills by writing one global permission rule, with JSON results",
  "type": "module",
  "exports": {
    ".": "./src/skill_management.js"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "permissions",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sogeisetsu/opencode-skill-management"
  },
  "bugs": {
    "url": "https://github.com/sogeisetsu/opencode-skill-management/issues"
  },
  "homepage": "https://sogeisetsu.github.io/opencode-skill-management/",
  "scripts": {
    "verify": "node tools/verify.mjs",
    "install:plugin": "node tools/install.mjs",
    "docs:dev": "astro dev --root site",
    "docs:build": "astro build --root site",
    "docs:check": "node site/scripts/check-dist.mjs",
    "docs:preview": "astro preview --root site"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.40.0",
    "astro": "^6.4.8"
  }
}
