---
/*
 * Generated by starlight-docs. A native <select> cannot be themed: its popup
 * and hover row are painted by the OS. This is a controlled list instead.
 */
const t = (key: string, fallback: string): string => {
  try {
    const value = Astro.locals.t(key)
    return value && value !== key ? value : fallback
  } catch {
    return fallback
  }
}

const labels = {
  dark: t('themeSelect.dark', 'Dark'),
  light: t('themeSelect.light', 'Light'),
  auto: t('themeSelect.auto', 'Auto'),
}
const menuLabel = t('themeSelect.accessibleLabel', 'Theme')
---

<div class="sd-menu" data-sd-menu data-sd-theme-menu>
  <button
    type="button"
    class="sd-menu-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={menuLabel}
  >
    <svg class="sd-menu-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42M5.64 18.36l1.42-1.42m9.88-9.88 1.42-1.42"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      />
      <circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6" />
    </svg>
    <span data-sd-theme-label>{labels.auto}</span>
    <svg class="sd-menu-caret" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" />
    </svg>
  </button>
  <ul class="sd-menu-list" role="listbox" aria-label={menuLabel}>
    <li><button type="button" role="option" data-sd-theme-value="dark" aria-selected="false">{labels.dark}</button></li>
    <li><button type="button" role="option" data-sd-theme-value="light" aria-selected="false">{labels.light}</button></li>
    <li><button type="button" role="option" data-sd-theme-value="auto" aria-selected="false">{labels.auto}</button></li>
  </ul>
</div>

<script>
  type Theme = 'auto' | 'dark' | 'light'

  // Starlight stores '' for Auto; null means "never chose". Conflating the two
  // makes a chosen light theme flip back on the next page.
  const storageKey = 'starlight-theme'

  const parseTheme = (value: unknown): Theme =>
    value === 'auto' || value === 'dark' || value === 'light' ? value : 'auto'

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' ? localStorage.getItem(storageKey) : null)

  const storeTheme = (theme: Theme): void => {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '')
    }
  }

  const preferredTheme = (): Theme => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')

  const updateMenus = (theme: Theme): void => {
    document.querySelectorAll<HTMLElement>('[data-sd-theme-menu]').forEach((menu) => {
      menu.querySelectorAll<HTMLElement>('[data-sd-theme-value]').forEach((option) => {
        option.setAttribute('aria-selected', String(option.dataset.sdThemeValue === theme))
      })
      const label = menu.querySelector<HTMLElement>('[data-sd-theme-label]')
      const active = menu.querySelector<HTMLElement>(`[data-sd-theme-value="${theme}"]`)
      if (label && active) label.textContent = active.textContent?.trim() ?? theme
    })
  }

  const closeMenus = (): void => {
    document.querySelectorAll<HTMLElement>('[data-sd-menu]').forEach((menu) => {
      menu.removeAttribute('data-open')
      menu.querySelector<HTMLElement>('.sd-menu-trigger')?.setAttribute('aria-expanded', 'false')
    })
  }

  const applyTheme = (theme: Theme): void => {
    document.documentElement.dataset.theme = theme === 'auto' ? preferredTheme() : theme
    storeTheme(theme)
    updateMenus(theme)
  }

  document.querySelectorAll<HTMLElement>('[data-sd-theme-menu]').forEach((menu) => {
    menu.querySelectorAll<HTMLElement>('[data-sd-theme-value]').forEach((option) => {
      option.addEventListener('click', () => {
        applyTheme(parseTheme(option.dataset.sdThemeValue))
        closeMenus()
      })
    })
  })

  // Shared open/close for the theme and language menus.
  document.querySelectorAll<HTMLElement>('[data-sd-menu]').forEach((menu) => {
    const trigger = menu.querySelector<HTMLElement>('.sd-menu-trigger')
    if (!trigger) return
    trigger.addEventListener('click', () => {
      const willOpen = !menu.hasAttribute('data-open')
      closeMenus()
      if (willOpen) {
        menu.setAttribute('data-open', '')
        trigger.setAttribute('aria-expanded', 'true')
      }
    })
  })

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-sd-menu]')) closeMenus()
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenus()
  })

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') applyTheme('auto')
  })

  updateMenus(loadTheme())
</script>
